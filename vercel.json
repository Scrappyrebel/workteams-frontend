{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "crons": [
    {
      "path": "/api/cron/attendance",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/shift-media/b2",
      "schedule": "30 6 * * *"
    },
    {
      "path": "/api/cron/workteams-b2-recover",
      "schedule": "15 */3 * * *"
    }
  ]
}
